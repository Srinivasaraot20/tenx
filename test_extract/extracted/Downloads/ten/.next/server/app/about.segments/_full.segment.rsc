15:[["$","title","0",{"children":"About Digital Marketing TenX | AI-Powered Digital Marketing & SEO Experts"}],["$","meta","1",{"name":"description","content":"Learn about Digital Marketing TenX, a results-driven digital marketing agency specializing in SEO, Google Ads, website development, AI automation, performance marketing, and business growth solutions. Meet our team, explore our mission, and discover how we help businesses achieve measurable growth through data-driven strategies."}],["$","link","2",{"rel":"canonical","href":"https://digitalmarketingtenx.com/about"}],["$","meta","3",{"property":"og:title","content":"About Digital Marketing TenX | AI-Powered Digital Marketing & SEO Experts"}],["$","meta","4",{"property":"og:description","content":"Learn about Digital Marketing TenX, a results-driven digital marketing agency specializing in SEO, Google Ads, website development, AI automation, performance marketing, and business growth solutions. Meet our team, explore our mission, and discover how we help businesses achieve measurable growth through data-driven strategies."}],["$","meta","5",{"property":"og:url","content":"https://digitalmarketingtenx.com/about"}],["$","meta","6",{"property":"og:image","content":"https://digitalmarketingtenx.com/og-image.png"}],["$","meta","7",{"property":"og:image:width","content":"1200"}],["$","meta","8",{"property":"og:image:height","content":"630"}],["$","meta","9",{"property":"og:image:alt","content":"About Digital Marketing TenX"}],["$","meta","10",{"property":"og:type","content":"website"}],["$","meta","11",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","12",{"name":"twitter:title","content":"About Digital Marketing TenX | AI-Powered Digital Marketing & SEO Experts"}],["$","meta","13",{"name":"twitter:description","content":"Learn about Digital Marketing TenX, a results-driven digital marketing agency specializing in SEO, Google Ads, website development, AI automation, performance marketing, and busin