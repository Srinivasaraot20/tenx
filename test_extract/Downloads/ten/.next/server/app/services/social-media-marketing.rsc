16:[["$","title","0",{"children":"Social Media Marketing Agency Madhapur | Grow Your Brand & Generate Leads | TenX"}],["$","meta","1",{"name":"description","content":"Boost your brand with our professional social media marketing agency in Madhapur. We manage Facebook ads, Instagram campaigns, and LinkedIn B2B strategy to grow your audience and generate qualified leads."}],["$","link","2",{"rel":"canonical","href":"https://digitalmarketingtenx.com/services/social-media-marketing"}],["$","meta","3",{"property":"og:title","content":"Social Media Marketing Services | Grow Your Brand & Generate Leads"}],["$","meta","4",{"property":"og:description","content":"Boost your brand with professional Social Media Marketing services. We create engaging content, manage campaigns, grow your audience, and generate qualified leads on Instagram, Facebook, LinkedIn, YouTube, TikTok, and more."}],["$","meta","5",{"property":"og:url","content":"https://digitalmarketingtenx.com/services/social-media-marketing"}],["$","meta","6",{"property":"og:image","content":"https://digitalmarketingtenx.com/social-media-marketing-dashboard.webp"}],["$","meta","7",{"property":"og:image:width","content":"1200"}],["$","meta","8",{"property":"og:image:height","content":"630"}],["$","meta","9",{"property":"og:image:alt","content":"Professional Social Media Marketing Dashboard"}],["$","meta","10",{"property":"og:type","content":"website"}],["$","meta","11",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","12",{"name":"twitter:title","content":"Social Media Marketing Services | Grow Your Brand & Generate Leads"}],["$","meta","13",{"name":"twitter:description","content":"Boost your brand with professional Social Media Marketing services. We create engaging content, manage campaigns, grow your audience, and generate qualified leads on Instagram, Facebook, LinkedIn, YouTube, TikTok, and more."}],["$","meta","14",{"name":"twitter:image","content":"https://digitalmarketingtenx.com/social-media-